{
  "name": "nova-salud",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env.local --test tests/integration.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "admin:hash": "node scripts/hash-password.js",
    "format": "prettier --write src server api scripts tests db *.json *.js README.md"
  },
  "dependencies": {
    "mongodb": "^6.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}

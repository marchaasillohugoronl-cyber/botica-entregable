# Solo servidor. Nunca uses el prefijo VITE_ para estas variables.
# Copia este archivo a .env.local (ignorado por Git).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nova_salud
# Opcional: clúster exclusivo de pruebas.
# TEST_MONGODB_URI=mongodb+srv://USER:PASSWORD@TEST_CLUSTER.mongodb.net/?retryWrites=true&w=majority
APP_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
# Genera el valor con npm run admin:hash. No uses la contraseña en texto plano.
ADMIN_PASSWORD_HASH=
